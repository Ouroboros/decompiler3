{
  // Decompiler3 Configuration File
  // This file uses JSON5 format (https://json5.org/)

  // Byte order for binary parsing
  // Values: "little" or "big"
  "endian": "little",
  "encoding": "UTF8",

  // Low mantissa bits the script VM drops when it stores a float (ED9: 2).
  // Float constants are printed as the shortest text that encodes to the same stored value.
  "float_dropped_bits": 2,

  // Add more configuration options here as needed
}
